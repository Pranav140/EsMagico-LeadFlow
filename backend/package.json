{
  "name": "leadflow-backend",
  "version": "1.0.0",
  "description": "LeadFlow CRM Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev":         "tsx watch src/index.ts",
    "build":       "tsc",
    "start":       "node dist/index.js",
    "seed":        "tsx prisma/seed.ts",
    "migrate":     "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push":     "prisma db push",
    "studio":      "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}
